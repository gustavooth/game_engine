{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "wgpu-matrix": ["node_modules/wgpu-matrix/dist/3.x/wgpu-matrix.d.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": [
    "sdk/**/*.ts",
    "demo/**/*.ts",
    "types.d.ts",
    "../engine/renderer/webgpu/**/*.ts"
  ]
}
