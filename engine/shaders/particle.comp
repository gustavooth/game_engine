#version 450

layout(local_size_x = 64) in;

struct Particle
{
  vec4 position_age;   // xyz = world position, w = age
  vec4 velocity_life;  // xyz = velocity, w = lifetime
};

layout(set = 0, binding = 0) buffer ParticleBuffer
{
  Particle particles[];
} particle_buffer;

layout(set = 0, binding = 1) buffer ParticleState
{
  uint rng;
  uint frame;
  uint active_count;
  uint padding;
} state;

layout(push_constant) uniform PushConstants
{
  vec4 emitter_position;  // xyz = position, w = spawn rate (particles/s)
  vec4 emitter_direction; // xyz = direction, w = spread (0..1)
  vec4 color_start;
  vec4 color_end;
  vec4 params;            // x = lifetime, y = speed, z = gravity, w = drag
  vec4 size;              // x = radius, y = random speed, z = dt, w = unused
  uint max_particles;
} pc;

uint hash(uint value)
{
  value ^= value >> 16u;
  value *= 0x7feb352du;
  value ^= value >> 15u;
  value *= 0x846ca68bu;
  value ^= value >> 16u;
  return value;
}

float random_float(inout uint seed)
{
  seed = seed * 1664525u + 1013904223u;
  return float(seed & 0x00FFFFFFu) / 16777216.0;
}

vec3 random_direction(inout uint seed)
{
  vec3 dir = vec3(random_float(seed) * 2.0 - 1.0,
                  random_float(seed) * 2.0 - 1.0,
                  random_float(seed) * 2.0 - 1.0);
  float length_sq = dot(dir, dir);
  if (length_sq < 0.0001)
    return vec3(0.0, 1.0, 0.0);
  return dir * inversesqrt(length_sq);
}

void main()
{
  uint index = gl_GlobalInvocationID.x;
  if (index >= pc.max_particles)
    return;

  float lifetime = max(pc.params.x, 0.001);
  float spawn_rate = pc.emitter_position.w;
  uint target = min(pc.max_particles, uint(max(spawn_rate * lifetime, 0.0)));
  if (index == 0u)
  {
    state.frame += 1u;
    state.active_count = target;
  }

  Particle particle = particle_buffer.particles[index];

  bool needs_spawn = particle.velocity_life.w <= 0.0 ||
                     particle.position_age.w >= particle.velocity_life.w;
  if (index >= target)
  {
    if (needs_spawn)
    {
      particle.position_age = vec4(0.0, 0.0, 0.0, 1.0e9);
      particle.velocity_life = vec4(0.0, 0.0, 0.0, 1.0e-5);
      particle_buffer.particles[index] = particle;
    }
    return;
  }

  if (needs_spawn)
  {
    uint seed = hash(index + 1u) ^ hash(state.frame + 17u);
    vec3 forward = normalize(pc.emitter_direction.xyz);
    vec3 direction = normalize(forward + random_direction(seed) * pc.emitter_direction.w * 0.85);
    vec3 offset = random_direction(seed) * pc.size.x;
    float speed = pc.params.y * mix(1.0 - pc.size.y, 1.0 + pc.size.y, random_float(seed));
    float life = lifetime * mix(0.85, 1.15, random_float(seed));

    particle.position_age = vec4(pc.emitter_position.xyz + offset, 0.0);
    particle.velocity_life = vec4(direction * speed, life);
    particle_buffer.particles[index] = particle;
    return;
  }

  float dt = pc.size.z;
  float age = particle.position_age.w + dt;
  vec3 velocity = particle.velocity_life.xyz;

  velocity.y -= pc.params.z * dt;
  velocity *= max(1.0 - pc.params.w * dt, 0.0);
  vec3 position = particle.position_age.xyz + velocity * dt;

  particle.position_age = vec4(position, age);
  particle.velocity_life = vec4(velocity, particle.velocity_life.w);
  particle_buffer.particles[index] = particle;
}
